{
  "name": "darkest_dungeon_patches",
  "version": "1.0.0",
  "private": true,
  "description": "Native Linux engine patches for Darkest Dungeon",
  "scripts": {
    "format": "clang-format -i *.c",
    "check:format": "clang-format --dry-run --Werror *.c",
    "check:tidy": "clang-tidy *.c --warnings-as-errors='*' -- -std=c11 -Wall -Wextra -Werror && clang-tidy resource_loading_patch.c --warnings-as-errors='*' -- -std=c11 -Wall -Wextra -Werror -DDD_PATCH_SELFTEST",
    "check": "pnpm run check:format && pnpm run check:tidy",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
